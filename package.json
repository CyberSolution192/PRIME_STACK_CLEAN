{
  "name": "primeconnect-dashboard",
  "version": "1.0.0",
  "description": "Production-ready dashboard for Prime Connect",
  "main": "index.html",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/app.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./dist/app.css --watch",
    "start": "python3 -m http.server 8000",
    "clean": "rm -f dist/app.css",
    "prebuild": "mkdir -p dist",
    "deploy": "npm run build && echo 'Build complete. Deploy the project root (index.html, dist/, *.js) to your web server.'",
    "test": "npm run build && echo 'Build test passed. dist/app.css regenerated.'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "supabase": "^2.76.12",
    "tailwindcss": "^3.4.19"
  },
  "keywords": [
    "dashboard",
    "data",
    "ghana",
    "supabase",
    "pwa"
  ],
  "author": "Prime Connect",
  "license": "MIT"
}